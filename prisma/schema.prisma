// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String       @id @default(cuid())
  name          String
  email         String       @unique
  emailVerified DateTime?
  image         String?
  password      String?
  accounts      Account[]
  sessions      Session[]
  campaigns     Campaign[]
  customNpcs    CustomNpc[]
  notes         Note[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Campaigns

model Campaign {
  id          String            @id @default(cuid())
  userId      String
  name        String
  description String?
  imageUrl    String?
  playerCount Int?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions    CampaignSession[]

  @@index([userId])
}

model CampaignSession {
  id          String   @id @default(cuid())
  campaignId  String
  title       String
  date        DateTime
  playerCount Int?
  description String?
  createdAt   DateTime @default(now())
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  encounters  Encounter[]

  @@index([campaignId])
}

// Bestiary

enum CreatureType {
  HUMANOID
  NECROPHAGE
  SPECTER
  BEAST
  CURSED_ONE
  HYBRID
  INSECTOID
  ELEMENTA
  RELICT
  OGROID
  DRACONID
  VAMPIRE
}

model CustomNpc {
  id        String       @id @default(cuid())
  userId    String
  name      String
  type      CreatureType
  details   Json?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Notes

model Note {
  id         String          @id @default(cuid())
  userId     String
  title      String
  content    String          @db.Text
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  encounters EncounterNote[]

  @@index([userId])
}

// NPC Tracker

model Encounter {
  id        String         @id @default(cuid())
  sessionId String
  name      String
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  session   CampaignSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  npcs      EncounterNpc[]
  notes     EncounterNote[]

  @@index([sessionId])
}

enum NpcSource {
  CORE
  CUSTOM
}

model EncounterNpc {
  id          String    @id @default(cuid())
  encounterId String
  source      NpcSource
  creatureId  String
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  encounter   Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@index([encounterId])
}

model EncounterNote {
  id          String    @id @default(cuid())
  encounterId String
  noteId      String
  encounter   Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  note        Note      @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([encounterId, noteId])
  @@index([encounterId])
}
